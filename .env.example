# CrazifiedEdits V1.2.1 — by Crazified Studios
# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY
ADMIN_EMAIL=your_admin_email@example.com

# Run node scripts/generate-secrets.mjs and paste generated secrets here.
PUBLIC_CLIENT_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN
CRON_SECRET=REPLACE_WITH_RANDOM_LONG_TOKEN
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_CHARACTER_HEX_KEY

# Google Cloud > APIs and services > Credentials > OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gdrive/callback
