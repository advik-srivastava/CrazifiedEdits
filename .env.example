# CrazifiedEdits V1.3 — by Crazified Studios
# Copy to .env.local for local development, or add each variable in Vercel → Settings → Environment Variables.
# NEVER commit real values. .env.local is git-ignored.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Secret: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# Email of the Supabase Auth user allowed into /admin. Comma-separate to allow several editors.
ADMIN_EMAIL=your_admin_email@example.com

# Run: node scripts/generate-secrets.mjs   and paste the generated values.
CRON_SECRET=REPLACE_WITH_RANDOM_LONG_TOKEN
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_CHARACTER_HEX_KEY
# Optional: only keeps old /client/<token> share links redirecting to the homepage.
PUBLIC_CLIENT_TOKEN=REPLACE_WITH_RANDOM_LONG_TOKEN

# Google Cloud → Google Auth Platform → Clients → Web application
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# Must exactly match an Authorized redirect URI in Google Cloud.
# Production: https://YOUR-DOMAIN/api/gdrive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gdrive/callback
